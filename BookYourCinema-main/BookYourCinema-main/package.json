{
  "name": "bookyourcinema",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -k \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client start",
    "build": "npm --prefix client run build",
    "test": "npm --prefix client test -- --watchAll=false"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
